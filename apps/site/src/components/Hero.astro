---
import type { HOME_QUERY_RESULT } from "@jav/content";
import Button from "@/components/Button.astro";
import { focalPoint, urlFor } from "@/lib/image";

type Props = NonNullable<HOME_QUERY_RESULT>;

const { heroImage: image, headline, subtext } = Astro.props;
const widths = [640, 1024, 1600, 2400];
const src = (w: number) => (image ? urlFor(image).width(w).fit("max").auto("format").url() : "");
---

<section
	class:list={[
		"relative isolate flex min-h-[70svh] items-end border-b border-border",
		image && "text-paper text-shadow-md",
	]}
>
	{
		image && (
			<>
				<img
					src={src(1600)}
					srcset={widths.map((w) => `${src(w)} ${w}w`).join(", ")}
					sizes="100vw"
					alt={image.alt ?? ""}
					fetchpriority="high"
					class="absolute inset-0 -z-10 size-full object-cover"
					style={{ objectPosition: focalPoint(image) }}
				/>
				<div class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-linear-to-t from-ink/60 to-transparent" />
			</>
		)
	}
	<div class="container-page py-12 md:py-24">
		<h1 class="max-w-3xl text-h1">{headline}</h1>
		{
			subtext && (
				<p class:list={["mt-4 max-w-prose text-lead md:mt-6", image ? "text-paper/85" : "text-muted"]}>
					{subtext}
				</p>
			)
		}
		<div class="mt-8 flex flex-col gap-3 sm:flex-row">
			<Button href="/support">Support Us</Button>
			<Button href="/about" variant={image ? "light" : "ghost"}>Our Story</Button>
		</div>
	</div>
</section>
