---
import Logo from "@/components/Logo.astro";
import Experiment from "@/experiments/Experiment.astro";
import { getSite, nav } from "@/lib/site";

const site = await getSite();
const path = Astro.url.pathname;
---

<header
	id="site-header"
	class="sticky top-0 z-40 border-b border-border bg-paper focus-within:translate-y-0 data-hidden:-translate-y-full motion-safe:transition-transform motion-safe:duration-200"
>
	<div class="container-page flex h-16 items-center justify-between gap-6">
		<a href="/" class="flex items-center gap-2.5 font-display text-h4 font-semibold tracking-tight">
			<Experiment id="logo-size" component={Logo} />
			{site.name}
		</a>
		<nav aria-label="Main">
			<ul class="flex items-center gap-6 text-small">
				{
					nav.map(([href, label]) => (
						<li>
							<a
								href={href}
								aria-current={path === href ? "page" : undefined}
								class:list={[
									"transition-colors hover:text-accent-600",
									path === href ? "text-ink" : "text-muted",
								]}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const header = document.getElementById("site-header");
	if (header) {
		let lastY = scrollY;
		let ticking = false;
		addEventListener(
			"scroll",
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					const y = scrollY;
					if (Math.abs(y - lastY) > 4) {
						header.toggleAttribute("data-hidden", y > lastY && y > header.offsetHeight);
						lastY = y;
					}
					ticking = false;
				});
			},
			{ passive: true },
		);
	}
</script>
