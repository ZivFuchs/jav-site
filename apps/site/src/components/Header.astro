---
import { getSite, nav } from "@/lib/site";

const site = await getSite();
const path = Astro.url.pathname;
---

<header class="border-b border-border">
	<div class="container-page flex h-16 items-center justify-between gap-6">
		<a href="/" class="font-display text-h4 font-semibold tracking-tight">{site.name}</a>
		<nav aria-label="Main">
			<ul class="flex items-center gap-6 text-small">
				{
					nav.map(([href, label]) => (
						<li>
							<a
								href={href}
								aria-current={path === href ? "page" : undefined}
								class:list={[
									"transition-colors hover:text-accent-600",
									path === href ? "text-ink" : "text-muted",
								]}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
