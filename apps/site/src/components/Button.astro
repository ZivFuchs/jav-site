---
import type { HTMLAttributes } from "astro/types";

interface Props extends Pick<HTMLAttributes<"a">, "href" | "target" | "rel"> {
	variant?: "primary" | "ghost";
	type?: "button" | "submit";
	class?: string;
}

const {
	href,
	target,
	rel,
	variant = "primary",
	type = "button",
	class: className = "",
} = Astro.props;

const base =
	"inline-flex items-center justify-center rounded-md px-5 py-2.5 text-small font-medium transition-colors";
const variants = {
	primary: "bg-accent-600 text-paper hover:bg-accent-700",
	ghost: "border border-rule text-ink hover:bg-neutral-100",
} as const;

const cls = [base, variants[variant], className].filter(Boolean).join(" ");
---

{
	href ? (
		<a href={href} target={target} rel={rel} class={cls}>
			<slot />
		</a>
	) : (
		<button type={type} class={cls}>
			<slot />
		</button>
	)
}
