---
import type { HTMLAttributes } from "astro/types";

interface Props extends Pick<HTMLAttributes<"a">, "href" | "target" | "rel"> {
	variant?: keyof typeof variants;
	type?: "button" | "submit";
	class?: string;
}

const variants = {
	primary: "animate-halo bg-linear-to-b from-accent-300 to-accent-400 text-ink hover:to-accent-300",
	ghost: "border border-rule text-ink hover:bg-neutral-100",
	/** Ghost for dark or photographic backgrounds. */
	light: "border border-paper/70 text-paper hover:bg-paper/10",
} as const;

const {
	href,
	target,
	rel,
	variant = "primary",
	type = "button",
	class: className = "",
} = Astro.props;

const base =
	"inline-flex items-center justify-center rounded-md px-5 py-2.5 text-small font-medium transition-colors";
const cls = [base, variants[variant], className].filter(Boolean).join(" ");
---

{
	href ? (
		<a href={href} target={target} rel={rel} class={cls}>
			<slot />
		</a>
	) : (
		<button type={type} class={cls}>
			<slot />
		</button>
	)
}
