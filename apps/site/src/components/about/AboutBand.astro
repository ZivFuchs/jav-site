---
import Button from "@/components/Button.astro";
import type { AboutProps } from "./types";

type Props = AboutProps;

const { heading, body } = Astro.props;
---

<section class="my-12 grid gap-6 rounded-lg bg-surface p-8 md:my-16 md:grid-cols-[1fr_2fr] md:gap-12 md:p-12">
	<h2 class="text-h2">{heading}</h2>
	<div>
		<p class="text-lead">{body}</p>
		<Button href="/about" class="mt-6">Read our story</Button>
	</div>
</section>
