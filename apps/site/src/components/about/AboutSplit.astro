---
import Button from "@/components/Button.astro";
import { focalPoint, imageUrl, srcset } from "@/lib/image";
import type { AboutProps } from "./types";

type Props = AboutProps;

const { heading, body, image } = Astro.props;
---

<section class="grid items-center gap-8 py-12 md:grid-cols-2 md:gap-12 md:py-16">
	<div>
		<p class="text-eyebrow font-medium tracking-[0.12em] text-muted uppercase">About us</p>
		<h2 class="mt-3 text-h2">{heading}</h2>
		<p class="mt-4 text-lead text-muted">{body}</p>
		<Button href="/about" variant="ghost" class="mt-6">Read our story</Button>
	</div>
	{
		image && (
			<img
				src={imageUrl(image, 800)}
				srcset={srcset(image, [480, 800, 1200])}
				sizes="(min-width: 48rem) 50vw, 100vw"
				alt={image.alt ?? ""}
				loading="lazy"
				decoding="async"
				class="aspect-4/3 w-full rounded-lg object-cover"
				style={{ objectPosition: focalPoint(image) }}
			/>
		)
	}
</section>
