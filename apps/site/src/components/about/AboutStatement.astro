---
import type { AboutProps } from "./types";

type Props = AboutProps;

const { heading, body } = Astro.props;
---

<section class="mx-auto max-w-prose py-12 text-center md:py-16">
	<p class="text-eyebrow font-medium tracking-[0.12em] text-muted uppercase">About us</p>
	<h2 class="mt-3 text-h2">{heading}</h2>
	<p class="mt-4 text-lead text-neutral-800">{body}</p>
	<a href="/about" class="mt-6 inline-block font-medium text-accent underline underline-offset-4">
		Read our story
	</a>
</section>
