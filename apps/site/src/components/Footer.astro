---
import { getSite, nav } from "@/lib/site";

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border">
	<div
		class="container-page flex flex-col gap-6 py-10 text-small text-muted md:flex-row md:items-center md:justify-between"
	>
		<p>&copy; {year} {site.legalName}</p>
		<nav aria-label="Footer">
			<ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
				{
					nav.map(([href, label]) => (
						<li>
							<a href={href} class="transition-colors hover:text-accent-600">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="flex items-center gap-6">
			<a href={`mailto:${site.email}`} class="transition-colors hover:text-accent-600">
				{site.email}
			</a>
			{
				site.socials && site.socials.length > 0 && (
					<ul class="flex items-center gap-4">
						{site.socials.map((s) => (
							<li>
								<a
									href={s.url}
									rel="noopener"
									target="_blank"
									aria-label={s.label}
									class="block size-5 transition-colors hover:text-accent-600 [&>svg]:size-full [&>svg]:fill-current"
									set:html={s.icon}
								/>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</footer>
