---
interface Props {
	title: string;
	lead?: string | null;
	eyebrow?: string;
}

const { title, lead, eyebrow } = Astro.props;
---

<div class="max-w-prose border-b border-border pb-8">
	{
		eyebrow && (
			<p class="text-eyebrow font-medium tracking-[0.12em] text-muted uppercase">{eyebrow}</p>
		)
	}
	<h1 class="mt-3 text-h1">{title}</h1>
	{lead && <p class="mt-4 text-lead text-muted">{lead}</p>}
</div>
