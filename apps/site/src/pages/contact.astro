---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getSite } from "@/lib/site";

const site = await getSite();
const lead = "We read everything that comes in.";
---

<Layout title="Contact" description={lead}>
	<PageHeader title="Contact" lead={lead} />
	<p class="mt-10 text-lead">
		<a
			href={`mailto:${site.email}`}
			class="text-accent-600 underline underline-offset-4 hover:text-accent-700"
		>
			{site.email}
		</a>
	</p>
</Layout>
