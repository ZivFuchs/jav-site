---
import { PROJECTS_QUERY } from "@jav/content";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Layout from "@/layouts/Layout.astro";
import { sanity } from "@/lib/sanity";

const projects = await sanity.fetch(PROJECTS_QUERY);
---

<Layout title="Projects" noindex={!projects.length}>
	<PageHeader
		title="Projects"
		lead={projects.length ? "The work JAV is doing on the ground." : "Coming soon."}
	/>
	<ul class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
		{projects.map((project) => <ProjectCard {...project} />)}
	</ul>
</Layout>
