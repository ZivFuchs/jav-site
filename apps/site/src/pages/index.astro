---
import { BOOK_QUERY, HOME_QUERY, PAGES_QUERY, PROJECTS_QUERY } from "@jav/content";
import AboutBand from "@/components/about/AboutBand.astro";
import AboutSplit from "@/components/about/AboutSplit.astro";
import AboutStatement from "@/components/about/AboutStatement.astro";
import Button from "@/components/Button.astro";
import BookHero from "@/components/book/BookHero.astro";
import Hero from "@/components/Hero.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Experiment from "@/experiments/Experiment.astro";
import Layout from "@/layouts/Layout.astro";
import { sanity } from "@/lib/sanity";
import { getSite } from "@/lib/site";

const site = await getSite();
const [home, book, pages, projects] = await Promise.all([
	sanity.fetch(HOME_QUERY),
	sanity.fetch(BOOK_QUERY),
	sanity.fetch(PAGES_QUERY),
	sanity.fetch(PROJECTS_QUERY),
]);
---

<Layout title={`${site.legalName} — ${site.tagline}`}>
	{
		book ? (
			<BookHero slot="hero" {...book} />
		) : (
			<Hero
				slot="hero"
				heroImage={home?.heroImage ?? null}
				headline={home?.headline ?? site.tagline}
				subtext={home?.subtext ?? site.description}
			/>
		)
	}

	<Experiment
		id="home-about"
		variants={{ statement: AboutStatement, split: AboutSplit, band: AboutBand }}
		props={{
			heading: home?.about?.heading ?? "About Us",
			body: home?.about?.body ?? site.description,
			image: home?.about?.image ?? null,
		}}
	/>

	{
		projects.length > 0 && (
			<section class="py-12 md:py-16">
				<div class="flex items-end justify-between gap-6">
					<h2 class="text-h2">Our projects</h2>
					<a href="/projects" class="hidden text-small text-muted hover:text-accent-600 sm:block">
						All projects →
					</a>
				</div>
				<ul class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
					{projects.slice(0, 3).map((project) => (
						<ProjectCard {...project} heading="h3" />
					))}
				</ul>
				<Button href="/projects" variant="ghost" class="mt-8 sm:hidden">
					All projects
				</Button>
			</section>
		)
	}

	{
		pages.length > 0 && (
			<section>
				<h2 class="text-h2">Pages</h2>
				<ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{pages.map((page) => (
						<li class="rounded-lg border border-border p-6 transition-colors hover:border-rule">
							<a href={`/${page.slug}`} class="block">
								<h3 class="text-h3">{page.title}</h3>
								{page.summary && <p class="mt-2 text-small text-muted">{page.summary}</p>}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>
