---
import { HOME_QUERY, PAGES_QUERY } from "@jav/content";
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import { sanity } from "@/lib/sanity";
import { getSite } from "@/lib/site";

const site = await getSite();
const [home, pages] = await Promise.all([sanity.fetch(HOME_QUERY), sanity.fetch(PAGES_QUERY)]);
---

<Layout title={`${site.legalName} — ${site.tagline}`}>
	<Hero
		slot="hero"
		heroImage={home?.heroImage ?? null}
		headline={home?.headline ?? site.tagline}
		subtext={home?.subtext ?? site.description}
	/>

	{
		pages.length > 0 && (
			<section>
				<h2 class="text-h2">Pages</h2>
				<ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{pages.map((page) => (
						<li class="rounded-lg border border-border p-6 transition-colors hover:border-rule">
							<a href={`/${page.slug}`} class="block">
								<h3 class="text-h3">{page.title}</h3>
								{page.summary && <p class="mt-2 text-small text-muted">{page.summary}</p>}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>
